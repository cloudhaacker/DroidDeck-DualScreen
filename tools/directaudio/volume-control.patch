+static void volume_control_update(void)
+{
+    FILE *f;
+    unsigned level, maximum, muted;
+    float gain = -1.0f;
+    int micro, old;
+
+    if (!g_volume_control) return;
+    f = fopen(g_volume_control, "r");
+    if (f)
+    {
+        if (fscanf(f, "%u %u %u %f", &level, &maximum, &muted, &gain) != 4 || !(gain >= 0.0f)) gain = -1.0f;
+        else if (gain > 1.0f) gain = 1.0f;
+        fclose(f);
+    }
+    micro = gain < 0.0f ? -1 : (int)(gain * 1e6f + 0.5f);
+    old = __atomic_exchange_n(&g_volume_micro, micro, __ATOMIC_ACQ_REL);
+    if (old != micro) REVENT("volume gain %.4f%s", gain, gain < 0.0f ? " (Android applies the volume)" : "");
+}
